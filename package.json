{
  "name": "mdbase-obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin for mdbase schema management and validation",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:test": "npm run build && node copy-files.mjs",
    "copy-files": "node copy-files.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "mdbase",
    "frontmatter",
    "schema"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/picomatch": "^4.0.2",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "picomatch": "^4.0.3"
  }
}
