{
  "name": "mdbase-obsidian",
  "version": "0.3.1",
  "description": "The Obsidian gateway to mdbase types and mdbase Connect",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check:mobile": "npm run build && node scripts/check-mobile.mjs",
    "build:test": "npm run build && node copy-files.mjs",
    "profile:testvault": "node scripts/profile-testvault.mjs",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.test.json && node --experimental-specifier-resolution=node --loader ./test/obsidian-loader.mjs --test .test-dist/test/**/*.test.js",
    "copy-files": "node copy-files.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "mdbase",
    "frontmatter",
    "schema"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/picomatch": "^4.0.2",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@callumalpass/mdbase-interop": "0.1.0-rc.2",
    "@mdbase-dev/connect-protocol": "0.1.0-beta.31",
    "@mdbase-dev/connect-sync": "0.1.0-beta.31",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "picomatch": "^4.0.5"
  }
}
